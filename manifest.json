{
  "manifest_version": 3,
  "name": "SWEA Session Keeper",
  "version": "1.3.0",
  "description": "SWEA 로그인 세션이 짧은 idle timeout으로 만료되는 것을 줄이기 위해 주기적으로 가벼운 요청을 보냅니다.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "idle"
  ],
  "host_permissions": [
    "https://swexpertacademy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SWEA Session Keeper"
  }
}
